# Sway configuration file
# See `man 5 sway` for documentation

seat seat0 xcursor_theme Adwaita 24

output * mode 1920x1080@60Hz

### Variables
set $ALT Mod1
set $left h
set $down j
set $up k
set $right l

set $term foot
set $www  firefox
set $menu bemenu-run --bottom

### Input configuration
input type:keyboard {
    xkb_layout us
    repeat_delay 220
    repeat_rate 30
}

input type:touchpad {
    tap enabled
    drag disabled
    drag_lock disabled
    accel_profile adaptive
    natural_scroll enabled
    dwt enabled
    pointer_accel 0.52
    scroll_factor 0.4
}

### Output configuration
# Configure outputs as needed:
# output <name> bg ~/wallpaper.png fill
# output HDMI-A-1 resolution 1920x1080 position 0,0

### Window gaps
gaps inner 2
gaps outer 2
smart_gaps on
smart_borders on

### Appearance
default_border pixel 1
default_floating_border normal
focus_follows_mouse yes
#mouse_warping container

# Colors
set $bg      #2e3440
set $fg      #d8dee9
set $focused #81a1c1
set $urgent  #bf616a

client.focused          $focused $focused $fg $bg $focused
client.focused_inactive $bg $bg $fg $bg $bg
client.unfocused        $bg $bg $fg $bg $bg
client.urgent           $urgent $urgent $fg $bg $urgent
client.placeholder      $bg $bg $fg $bg $bg
client.background       $bg














### Keybindings
# Reload / restart / exit
bindsym $ALT+Shift+c reload
bindsym $ALT+Shift+r restart
bindsym $ALT+Shift+BackSpace exit

# layout modes
bindsym $ALT+Tab layout toggle tabbed split
bindsym $ALT+w layout tabbed
bindsym $ALT+s layout stacking
bindsym $ALT+e layout toggle split
bindsym $ALT+b layout toggle splith splitv

# focus
bindsym $ALT+$left focus left
bindsym $ALT+$down focus down
bindsym $ALT+$up   focus up
bindsym $ALT+$right focus right

# Move focused window with direction keys
bindsym $ALT+Ctrl+$left move left
bindsym $ALT+Ctrl+$down move down
bindsym $ALT+Ctrl+$up move up
bindsym $ALT+Ctrl+$right move right

### Resizing
mode "resize" {
    bindsym $left resize shrink width 10 px
    bindsym $down resize grow height 10 px
    bindsym $up resize shrink height 10 px
    bindsym $right resize grow width 10 px
    bindsym Return mode default
    bindsym Escape mode default
    bindsym $ALT+Return mode default
}
bindsym $ALT+r mode "resize"

# Default direction keys
# bindsym $ALT+$left focus left
# bindsym $ALT+$down focus down
# bindsym $ALT+$up focus up
# bindsym $ALT+$right focus right




# Workspaces
bindsym Mod4+q workspace number 1
bindsym Mod4+w workspace number 2
bindsym Mod4+e workspace number 3
bindsym Mod4+r workspace number 4
bindsym Mod4+t workspace number 5
bindsym Mod4+y workspace number 6
bindsym Mod4+u workspace number 7
bindsym Mod4+i workspace number 8
bindsym Mod4+o workspace number 9
bindsym Mod4+p workspace number 10

bindsym $ALT+Shift+l workspace next
bindsym $ALT+Shift+h workspace prev

# Move focused container to workspace
bindsym Mod4+Shift+q move container to workspace number 1
bindsym Mod4+Shift+w move container to workspace number 2
bindsym Mod4+Shift+e move container to workspace number 3
bindsym Mod4+Shift+r move container to workspace number 4
bindsym Mod4+Shift+t move container to workspace number 5
bindsym Mod4+Shift+y move container to workspace number 6
bindsym Mod4+Shift+u move container to workspace number 7
bindsym Mod4+Shift+i move container to workspace number 8
bindsym Mod4+Shift+o move container to workspace number 9
bindsym Mod4+Shift+p move container to workspace number 10

# Scratchpad
bindsym $ALT+Shift+minus move scratchpad
bindsym $ALT+minus scratchpad show


# Focus
bindsym $ALT+o focus parent
bindsym $ALT+i focus child


# Fullscreen
bindsym $ALT+f fullscreen toggle

# Floating
bindsym $ALT+Shift+space floating toggle

# Kill focused window
bindsym $ALT+Shift+q kill




# Application launcher
bindsym $ALT+d exec $menu

# Terminal
bindsym $ALT+t exec $term

# Web browser
bindsym $ALT+q exec $www

# Screenshots (uncomment and install grim + slurp to use)
# bindsym Print exec grim
# bindsym $ALT+Print exec grim -g "$(slurp)"

# Media keys
bindsym XF86AudioRaiseVolume exec ~/.config/sway/sway-volume-up.sh
bindsym XF86AudioLowerVolume exec ~/.config/sway/sway-volume-down.sh
bindsym XF86AudioMute exec pactl set-sink-mute @DEFAULT_SINK@ toggle
bindsym Shift+XF86AudioRaiseVolume exec ~/.config/sway/sway-shairport-volume-up.sh
bindsym Shift+XF86AudioLowerVolume exec ~/.config/sway/sway-shairport-volume-down.sh


### Bar
bar {
    position top
    status_command i3status-rs ~/.config/i3status-rust/config.toml
    colors {
        statusline #d8dee9
        background #2e3440
        inactive_workspace #2e3440 #2e3440 #d8dee9
    }
}

# show app_id and class in i3status
for_window [app_id=".*"] title_format "%app_id — %title"
for_window [class=".*"] title_format "%class — %title"

# mouse right click on alt + tap
bindsym --whole-window Mod1+button1 seat - cursor press button3, seat - cursor release button3

# steam
for_window [class="steam"] move to workspace 5

# wallpaper
output * background ~/Pictures/wallpaper/wallpaper.png fill

## Move all native Wine apps to workspace 5 and enable floating
#assign [app_id="^wine.*"] 5
#for_window [app_id="^wine.*"] floating enable

# Copy / paste with Super+C / Super+V -- only in Firefox
bindsym --release --no-repeat Mod4+c exec ~/.config/sway/sway-ff-clip.sh copy
bindsym --release --no-repeat Mod4+v exec ~/.config/sway/sway-ff-clip.sh paste





# Forces Sway to hand over absolute pointer constraints to XWayland
seat * shortcuts_inhibitor enable

for_window [app_id=".*"] inhibit_idle fullscreen
for_window [class=".*"] inhibit_idle fullscreen


### Startup
xwayland enable
exec fcitx5 -d

# wob volume overlay (reads values from its FIFO on stdin)
exec sh -c '[ -p "$XDG_RUNTIME_DIR/wob.fifo" ] || mkfifo -m 600 "$XDG_RUNTIME_DIR/wob.fifo"; pgrep -x wob >/dev/null || exec wob <> "$XDG_RUNTIME_DIR/wob.fifo"'
exec STEAM_LINUX_RUNTIME_LOG=1 STEAM_LINUX_RUNTIME_VERBOSE=1 ~/.local/share/Steam/steam.sh > /tmp/steam.log 2>&1

#exec swaylock -f

exec swayidle -w \
    timeout 600 'swaylock -f -c 000000' \
    timeout 600 'swaymsg "output * power off"' \
    resume 'swaymsg "output * power on"' \
    before-sleep 'swaylock -f'
