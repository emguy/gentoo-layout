export MANPATH="$HOME/.local/share/man:$MANPATH"

export KUBE_EDITOR="nvim"
export DOCKER_CONFIG="$HOME/.docker"

export MANPAGER="/usr/bin/less -R --use-color -Ddc -Du+y"

