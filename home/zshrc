#!/usr/bin/env zsh
if [ -f '/etc/zshrc' ]; then
  source /etc/zshrc
fi

export QMK_DISTRIB_DIR="$HOME/.local/qmk-distrib"
export QMK_HOME="$HOME/git/qmk-firmware"

# zsh prompt
autoload -Uz vcs_info
precmd() { vcs_info }
zstyle ':vcs_info:git:*' formats '(%b) '
setopt PROMPT_SUBST
if [ "$(tput colors 2>/dev/null || echo 8)" -ge 256 ] 2>/dev/null; then
  PROMPT='%F{226}%n@zsh%f %F{69}%~%f %F{112}${vcs_info_msg_0_}%f%F{69}$%f '
else
  PROMPT='%B%F{3}%n@zsh%f%b %B%F{4}%~%f%b %B%F{2}${vcs_info_msg_0_}%f%b%F{4}$%f '
fi

if [ -f "$HOME/.variables.sh" ]; then
  source "$HOME/.variables.sh"
fi

export PATH="$PATH:$HOME/.local/bin:$HOME/.local/npm-global/bin"

#if [ -f '/etc/zshrc_Apple_Terminal' ]; then
#  source /etc/zshrc_Apple_Terminal
#fi

# Shell is non-interactive.  Be done now!
# if [[ $- != *i* ]] ; then
#   return
# fi

# set LS_COLORS
if [ -f "$HOME/.dir_colors" ]; then
  eval "$(dircolors -b $HOME/.dir_colors)"
fi

bindkey -e
bindkey ^v forward-word
bindkey ^y backward-word
bindkey ^u backward-kill-line


# zsh history configurations
setopt SHARE_HISTORY
setopt EXTENDED_HISTORY
setopt INC_APPEND_HISTORY
export HISTSIZE=100000
export SAVEHIST=100000
export HISTFILE="$HOME/.zsh_history"

# auto-completion
autoload -Uz compinit && compinit

export LANG="en_US.UTF-8"
export LC_ALL="en_US.UTF-8"
